+/**
+ * Advanced windowing support for DayDream X in Terbium.
+ *
+ * Enables custom chrome with frameless dragging, titlebar integration,
+ * and proper window management APIs.
+ */
+
+const TAG = '[terbium/advancedWindowing]';
+
+interface WindowControls {
+	minimize?: HTMLElement;
+	maximize?: HTMLElement;
+	close?: HTMLElement;
+}
+
+/**
+ * Set up frameless window dragging for the browser UI
+ */
+function setupFramelessDragging(tb: any): void {
+	// DayDream X has a top bar that should be draggable
+	const topBar = document.querySelector('[data-component="top-bar"]') as HTMLElement;
+	const utilityBar = document.querySelector('[data-component="utility-bar"]') as HTMLElement;
+	
+	if (!topBar) {
+		console.warn(TAG, 'top-bar not found, skipping frameless drag setup');
+		return;
+	}
+
+	// Elements that should NOT trigger dragging
+	const noDragSelectors = [
+		'[data-component="tab-bar"]',
+		'[data-component="profiles"]',
+		'[data-component="new-tab"]',
+		'button',
+		'input',
+		'a',
+		'.tab',
+		'[data-component="address-bar"]'
+	];
+
+	let isDragging = false;
+	let dragStartX = 0;
+	let dragStartY = 0;
+
+	topBar.addEventListener('mousedown', (e: MouseEvent) => {
+		// Check if click is on a non-draggable element
+		for (const selector of noDragSelectors) {
+			if ((e.target as HTMLElement).closest(selector)) {
+				return;
+			}
+		}
+
+		e.preventDefault();
+		const iframeRect = window.frameElement?.getBoundingClientRect();
+		if (!iframeRect) return;
+
+		dragStartX = e.clientX + iframeRect.left;
+		dragStartY = e.clientY + iframeRect.top;
+
+		const onMouseMove = (moveEvent: MouseEvent) => {
+			const currentRect = window.frameElement?.getBoundingClientRect();
+			if (!currentRect) return;
+
+			const parentX = moveEvent.clientX + currentRect.left;
+			const parentY = moveEvent.clientY + currentRect.top;
+
+			if (!isDragging) {
+				isDragging = true;
+				window.parent.postMessage({
+					type: 'tb-frameless-drag-start',
+					wid: window.frameElement?.closest('.window-element')?.id,
+					parentX: dragStartX,
+					parentY: dragStartY
+				}, '*');
+			}
+
+			window.parent.postMessage({
+				type: 'tb-frameless-drag-move',
+				wid: window.frameElement?.closest('.window-element')?.id,
+				parentX,
+				parentY
+			}, '*');
+		};
+
+		const onMouseUp = () => {
+			document.removeEventListener('mousemove', onMouseMove);
+			document.removeEventListener('mouseup', onMouseUp);
+
+			if (isDragging) {
+				window.parent.postMessage({
+					type: 'tb-frameless-drag-end',
+					wid: window.frameElement?.closest('.window-element')?.id
+				}, '*');
+				isDragging = false;
+			}
+		};
+
+		document.addEventListener('mousemove', onMouseMove);
+		document.addEventListener('mouseup', onMouseUp);
+	});
+
+	// Double-click to maximize
+	topBar.addEventListener('dblclick', (e: MouseEvent) => {
+		for (const selector of noDragSelectors) {
+			if ((e.target as HTMLElement).closest(selector)) {
+				return;
+			}
+		}
+
+		window.parent.postMessage({
+			type: 'tb-frameless-dblclick',
+			wid: window.frameElement?.closest('.window-element')?.id
+		}, '*');
+	});
+
+	console.log(TAG, 'frameless dragging enabled on top-bar');
+}
+
+/**
+ * Sync window title with the active tab
+ */
+function setupTitleSync(tb: any): void {
+	if (!tb?.window?.titlebar?.setText) return;
+
+	// Watch for tab changes and update title
+	const updateTitle = () => {
+		const activeTab = document.querySelector('.tab.active .tab-title');
+		if (activeTab) {
+			const title = activeTab.textContent || 'DayDream X';
+			tb.window.titlebar.setText(`DayDream X - ${title}`);
+		}
+	};
+
+	// Observe tab changes
+	const observer = new MutationObserver(updateTitle);
+	const tabBar = document.querySelector('[data-component="tab-bar"]');
+	if (tabBar) {
+		observer.observe(tabBar, { childList: true, subtree: true, characterData: true });
+	}
+
+	// Initial update
+	updateTitle();
+
+	console.log(TAG, 'title sync enabled');
+}
+
+export function installAdvancedWindowing(tb: any): void {
+	if (!tb?.window) {
+		console.warn(TAG, 'tb.window not available — skipping install');
+		return;
+	}
+
+	setupFramelessDragging(tb);
+	setupTitleSync(tb);
+
+	console.log(TAG, 'advanced windowing installed');
+}
