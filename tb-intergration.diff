index 0000000..0000000
--- /dev/null
+++ b/src/terbium/notifications.ts
@@ -0,0 +1,89 @@
+/**
+ * Terbium Notification integration for DayDream X.
+ *
+ * Routes browser notifications through Terbium's notification system
+ * for a native OS-like experience.
+ */
+
+const TAG = '[terbium/notifications]';
+
+interface NotificationOptions {
+	body?: string;
+	icon?: string;
+	tag?: string;
+	data?: any;
+	requireInteraction?: boolean;
+}
+
+/**
+ * Wrapper around Notification API that routes through Terbium
+ */
+class TerbiumNotificationBridge {
+	private tb: any;
+	private nativeNotification: typeof Notification | null = null;
+
+	constructor(tb: any) {
+		this.tb = tb;
+		this.nativeNotification = (globalThis as any).__nativeNotification || Notification;
+	}
+
+	createNotification(title: string, options?: NotificationOptions): void {
+		if (!this.tb?.notification?.Toast) {
+			console.warn(TAG, 'tb.notification.Toast not available, falling back to native');
+			if (this.nativeNotification && Notification.permission === 'granted') {
+				new this.nativeNotification(title, options);
+			}
+			return;
+		}
+
+		// Convert to Terbium toast
+		this.tb.notification.Toast({
+			message: title,
+			application: 'DayDream X',
+			iconSrc: options?.icon || './icon.png',
+			time: options?.requireInteraction ? 0 : 5000
+		});
+	}
+
+	install(): void {
+		// Store native Notification for fallback
+		if (typeof Notification !== 'undefined') {
+			(globalThis as any).__nativeNotification = Notification;
+		}
+
+		// Override Notification constructor
+		const bridge = this;
+		(globalThis as any).Notification = function(title: string, options?: NotificationOptions) {
+			bridge.createNotification(title, options);
+			return {
+				close: () => {},
+				addEventListener: () => {},
+				removeEventListener: () => {}
+			};
+		};
+
+		// Mock static properties
+		(globalThis as any).Notification.permission = 'granted';
+		(globalThis as any).Notification.requestPermission = async () => 'granted';
+
+		console.log(TAG, 'notification bridge installed');
+	}
+}
+
+export function installNotifications(tb: any): void {
+	if (!tb?.notification?.Toast) {
+		console.warn(TAG, 'tb.notification.Toast not available — skipping install');
+		return;
+	}
+
+	const bridge = new TerbiumNotificationBridge(tb);
+	bridge.install();
+
+	// Also expose a direct API for internal use
+	(globalThis as any).__ddxNotify = (message: string, options?: any) => {
+		tb.notification.Toast({
+			message,
+			application: 'DayDream X',
+			iconSrc: './icon.png',
+			...options
+		});
+	};
+}
