{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--executable-path",
        "/usr/bin/chromium",
        "--no-sandbox",
        "--isolated",
        "--viewport-size",
        "1280,720"
      ],
      "enabled": true,
      "env": {}
    }
  }
}
